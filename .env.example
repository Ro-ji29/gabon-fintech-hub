# ==============================================================================
# GABON FINTECH HUB — VARIABLES D'ENVIRONNEMENT (Vercel & Local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DESTINATION EMAIL (Resend)
# ------------------------------------------------------------------------------
# Clé secrète de l'API Resend (obtenue sur https://resend.com/api-keys)
# À renseigner obligatoirement dans Vercel (Settings > Environment Variables)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse email de réception officielle de toutes les notifications
# À CONFIRMER : adresse à valider par le client avant la mise en ligne
NOTIFICATION_EMAIL=contact@gabonfintech-hub.com
VITE_CONTACT_EMAIL=contact@gabonfintech-hub.com

# Adresse d'expédition validée sur Resend (par défaut onboarding@resend.dev en test)
RESEND_FROM_EMAIL=Gabon FinTech Hub <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. DESTINATION GOOGLE SHEET (Google Apps Script Web App)
# ------------------------------------------------------------------------------
# URL Webhook générée lors du déploiement de l'Apps Script en "Application Web"
# (script disponible dans scripts/google-apps-script.js)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxx/exec
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxx/exec

# ------------------------------------------------------------------------------
# 3. MODE TEST (Pour valider de bout en bout sans polluer les données réelles)
# ------------------------------------------------------------------------------
# Passez à 'true' pour tester : les emails partent avec le préfixe [TEST GFH]
# et les lignes s'écrivent dans l'onglet "Test" du Google Sheet.
VITE_TEST_MODE=false
TEST_MODE=false
TEST_NOTIFICATION_EMAIL=test@gabonfintech-hub.com
VITE_TEST_CONTACT_EMAIL=test@gabonfintech-hub.com

# ------------------------------------------------------------------------------
# 4. CONFIGURATION GÉNÉRALE DU SITE
# ------------------------------------------------------------------------------
# URL publique définitive du site (pour balises Open Graph LinkedIn)
VITE_SITE_URL=https://gabonfintech-hub.com
