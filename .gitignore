# Dépendances Node
node_modules/
npm/

# Build de production (généré automatiquement par `npm run build`)
dist/

# Variables d'environnement — NE JAMAIS VERSIONNER
.env
.env.local
.env.production
.env.*.local

# Cache Vite / éditeur
.vite/
*.local

# macOS
.DS_Store
**/.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archives
*.zip
*.tar.gz

# Éditeur
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
